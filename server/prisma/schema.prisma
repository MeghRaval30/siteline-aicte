generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Roles: Admin (AICTE Approval Bureau), Officer (Regional Office scrutiny),
// Expert (EVC member), Institution (applicant institution user)
model User {
  id             Int      @id @default(autoincrement())
  name           String
  email          String   @unique
  password_hash  String
  role           String   @default("Officer")
  status         String   @default("Active")
  phone          String?
  designation    String?
  state          String?
  specialization String?
  region_id      Int?
  institution_id Int?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  region      Region?      @relation(fields: [region_id], references: [id])
  institution Institution? @relation(fields: [institution_id], references: [id])

  transitions           StageTransition[]
  assigned_applications Application[]       @relation("AssignedOfficer")
  deficiencies_raised   Deficiency[]
  evc_memberships       EVCMember[]
  notifications         Notification[]
  activity_logs         ActivityLog[]
  conversation_sessions ConversationSession[]
}

model Region {
  id         Int    @id @default(autoincrement())
  name       String @unique
  code       String @unique
  city       String
  states     String // comma separated states covered

  institutions Institution[]
  users        User[]
}

model Institution {
  id                Int      @id @default(autoincrement())
  aicte_id          String   @unique
  name              String
  type              String // Engineering, Management, Pharmacy, Architecture, Polytechnic, MCA, HMCT
  ownership         String // Government, Private Self-Financing, Government-Aided, Deemed
  state             String
  city              String
  region_id         Int
  established_year  Int
  approved_intake   Int      @default(0)
  status            String   @default("Active") // Active, Under Show-Cause, Suspended, Closed
  head_name         String?
  email             String?
  phone             String?
  created_at        DateTime @default(now())

  region       Region               @relation(fields: [region_id], references: [id])
  users        User[]
  applications Application[]
  documents    ComplianceDocument[]
  undertakings Undertaking[]
  alerts       Alert[]
}

model Application {
  id                  Int       @id @default(autoincrement())
  app_number          String    @unique
  institution_id      Int
  type                String // New Institution, Extension of Approval, Increase in Intake, New Course, Change of Name, Change of Site, Closure
  academic_year       String
  stage               String    @default("SUBMITTED")
  status              String    @default("In Process") // In Process, Approved, Conditionally Approved, Rejected, Withdrawn
  stage_entered_at    DateTime  @default(now())
  submitted_at        DateTime  @default(now())
  decided_at          DateTime?
  assigned_officer_id Int?
  priority            String    @default("Normal") // Normal, High, Court-Directed
  intake_requested    Int?
  courses             String? // comma separated
  decision_remarks    String?
  letter_code         String?   @unique
  rescrutiny_count    Int       @default(0)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  institution      Institution          @relation(fields: [institution_id], references: [id])
  assigned_officer User?                @relation("AssignedOfficer", fields: [assigned_officer_id], references: [id])
  transitions      StageTransition[]
  deficiencies     Deficiency[]
  evc_visits       EVCVisit[]
  undertakings     Undertaking[]
  documents        ComplianceDocument[]
}

model StageTransition {
  id             Int      @id @default(autoincrement())
  application_id Int
  from_stage     String?
  to_stage       String
  actor_id       Int?
  remarks        String?
  days_in_stage  Int      @default(0)
  sla_breached   Boolean  @default(false)
  created_at     DateTime @default(now())

  application Application @relation(fields: [application_id], references: [id])
  actor       User?       @relation(fields: [actor_id], references: [id])
}

model Deficiency {
  id             Int       @id @default(autoincrement())
  application_id Int
  raised_by      Int?
  category       String // Land, Building, Faculty, Infrastructure, Financial, Documents, Library, Laboratory
  description    String
  severity       String    @default("Major") // Minor, Major, Critical
  status         String    @default("Open") // Open, Responded, Accepted, Rejected
  response       String?
  due_date       DateTime?
  responded_at   DateTime?
  created_at     DateTime  @default(now())

  application Application @relation(fields: [application_id], references: [id])
  raiser      User?       @relation(fields: [raised_by], references: [id])
}

model EVCVisit {
  id             Int       @id @default(autoincrement())
  application_id Int
  visit_date     DateTime
  mode           String    @default("Physical") // Physical, Virtual, Hybrid
  status         String    @default("Scheduled") // Scheduled, Completed, Rescheduled, Cancelled
  recommendation String? // Recommended, Not Recommended, Recommended with Conditions
  report         String?
  score          Int? // 0-100 infrastructure score from the visit
  completed_at   DateTime?
  created_at     DateTime  @default(now())

  application Application @relation(fields: [application_id], references: [id])
  members     EVCMember[]
}

model EVCMember {
  visit_id Int
  user_id  Int
  is_chair Boolean @default(false)

  visit EVCVisit @relation(fields: [visit_id], references: [id])
  user  User     @relation(fields: [user_id], references: [id])

  @@id([visit_id, user_id])
}

// A time-bound undertaking attached to a conditional approval
model Undertaking {
  id              Int       @id @default(autoincrement())
  institution_id  Int
  application_id  Int?
  title           String
  description     String?
  category        String // Lease Renewal, Faculty Recruitment, Building Completion, Fire NOC, Land Conversion, Library, Accreditation
  due_date        DateTime
  status          String    @default("Pending") // Pending, Submitted, Verified, Overdue, Breached, Waived
  submission_note String?
  submitted_at    DateTime?
  verified_at     DateTime?
  verifier_note   String?
  created_at      DateTime  @default(now())

  institution Institution  @relation(fields: [institution_id], references: [id])
  application Application? @relation(fields: [application_id], references: [id])
}

// Prescribed documents with validity (lease deed, fire NOC, ...)
model ComplianceDocument {
  id                Int       @id @default(autoincrement())
  institution_id    Int
  application_id    Int?
  doc_type          String
  doc_number        String?
  issued_by         String?
  valid_from        DateTime?
  valid_to          DateTime? // null = permanent
  status            String    @default("Pending Verification") // Pending Verification, Valid, Expiring Soon, Expired, Rejected, Superseded
  file_name         String?
  file_url          String?
  verified_by       String?
  remarks           String?
  renewal_of_id     Int?
  created_at        DateTime  @default(now())

  institution Institution  @relation(fields: [institution_id], references: [id])
  application Application? @relation(fields: [application_id], references: [id])
}

// Playbook-style standing rule: watches a condition, raises an alert, never acts.
model AlertRule {
  id          Int       @id @default(autoincrement())
  name        String
  trigger     String // DOC_EXPIRING, DOC_EXPIRED, UNDERTAKING_DUE, UNDERTAKING_OVERDUE, STAGE_SLA_BREACH, EVC_UPCOMING, EVC_REPORT_PENDING, DEFICIENCY_OVERDUE
  params      String    @default("{}") // JSON, e.g. {"days":30,"doc_type":"Land Lease Deed"}
  criteria    String    @default("{}") // JSON segment, e.g. {"region":"SRO","type":"Engineering"}
  severity    String    @default("Medium") // Low, Medium, High, Critical
  notify_roles String   @default("Admin,Officer")
  notify_institution Boolean @default(true)
  active      Boolean   @default(true)
  nl_prompt   String?
  last_run    DateTime?
  created_at  DateTime  @default(now())

  alerts Alert[]
}

model Alert {
  id              Int       @id @default(autoincrement())
  rule_id         Int?
  institution_id  Int?
  entity_type     String // Application, Document, Undertaking, EVCVisit, Deficiency
  entity_id       Int
  title           String
  detail          String?
  severity        String    @default("Medium")
  status          String    @default("Open") // Open, Acknowledged, Resolved
  fired_at        DateTime  @default(now())
  acknowledged_by String?
  acknowledged_at DateTime?
  resolved_at     DateTime?

  rule        AlertRule?   @relation(fields: [rule_id], references: [id])
  institution Institution? @relation(fields: [institution_id], references: [id])

  // One alert per rule per entity: a rule that re-fires every run is a rule people learn to ignore.
  @@unique([rule_id, entity_type, entity_id])
}

model Notification {
  id                  Int      @id @default(autoincrement())
  user_id             Int
  type                String
  message             String
  related_entity_type String?
  related_entity_id   Int?
  is_read             Boolean  @default(false)
  created_at          DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])
}

model ActivityLog {
  id            Int      @id @default(autoincrement())
  actor_user_id Int?
  action        String
  entity_type   String?
  entity_id     Int?
  metadata      String?
  created_at    DateTime @default(now())

  actor User? @relation(fields: [actor_user_id], references: [id])
}

model ConversationSession {
  id         String   @id @default(uuid())
  user_id    Int
  messages   String   @default("[]")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id])
}
