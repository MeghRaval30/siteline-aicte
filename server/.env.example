DATABASE_URL="file:./dev.db"
# Signing secret for sessions. Must be a random value of 32+ characters in production
# (the server refuses to start otherwise). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Left as-is in development, a random per-process secret is used instead.
JWT_SECRET="change-me"
# Browser origins allowed to call the API (comma separated). Same-origin needs no entry.
# CORS_ORIGINS="http://localhost:5173"
# Optional: TOKEN_TTL=8h  LOGIN_RATE_LIMIT=20  TRUST_PROXY=true (behind a reverse proxy)
# Optional: OLLAMA_MODEL="qwen2.5:7b"  AI_AUTOSTART=false  ALERT_INTERVAL_MIN=10
